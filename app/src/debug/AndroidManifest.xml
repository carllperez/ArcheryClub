<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <application android:networkSecurityConfig="@xml/debug_network_security">
        <!-- Secondary debug-only launcher; original member app entry is unchanged. -->
        <activity
            android:name=".prototype.OfficerDemoActivity"
            android:exported="true"
            android:label="Archery Officer Demo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
